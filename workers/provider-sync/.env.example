# workers/provider-sync/.env.example
#
# Env-var CONTRACT for the provider-sync worker container (Plaid PRIMARY + SimpleFIN
# FALLBACK per ADR-027 gate (i)). Real values are Coolify-injected on the greenfield
# production VPS at deploy time (ADR-021) — NEVER commit real values; this file is
# the shape contract only. Names here mirror secrets-manifest.yml `production_only`.
#
# TRANSPORT: DIRECT Postgres to pfin (postgres.js / node-postgres + PFIN_DB_PASSWORD)
# via TenantBoundClient (Lock 13 mod #3). SUPABASE_SERVICE_ROLE_KEY is DELIBERATELY
# ABSENT — the worker must NOT use the Supabase admin JS client (keeps it off the
# RT-26 allowlist per SECURITY §4.1; enforced by scripts/ci/fence-tbc-node.sh).
#
# DB LOGIN ROLE = `authenticator` (F/CTO-ratified; Sec conditions C1/C3). The worker
# connects AS Supabase's `authenticator` NOINHERIT broker role — NOT service_role.
# Privileged writes still execute AS `service_role` via `SET LOCAL ROLE service_role`
# inside TenantBoundClient (ADR-023 write role-of-record is UNCHANGED — only the
# connection/login role is pinned to authenticator).
#
# CONDITION C1 (rotation coupling — Sec-load-bearing): provider-sync's
# PFIN_DB_PASSWORD == the `authenticator` password == PostgREST's credential. This
# is a SHARED credential. Rotating either the worker's value or PostgREST's forces a
# COORDINATED redeploy of BOTH PostgREST and this worker — they must move together
# or auth breaks. Do not rotate one in isolation.

# --- pfin direct-Postgres transport (login role = authenticator; writes AS service_role per ADR-023) ---
PFIN_DB_HOST=localhost
PFIN_DB_PORT=5432
PFIN_DB_NAME=pfin
PFIN_DB_USER=authenticator
PFIN_DB_PASSWORD=          # secret (production_only) — the `authenticator` password (== PostgREST cred; C1 rotation coupling); Coolify-injected

# --- Plaid (PRIMARY provider; production tier gated by SELF-212) ---
PLAID_ENV=sandbox          # non-secret — Plaid API tier; V1.0 = sandbox (code-side default); production gated by SELF-212
PLAID_CLIENT_ID=           # secret (production_only) — shared with api/ + workers/etl/
PLAID_SECRET=              # secret (production_only)

# --- SimpleFIN (FALLBACK provider — banks/cards Plaid drops) ---
SIMPLEFIN_TOKEN=           # secret (production_only) — access token/URL

# --- SELF-212 Option-C admission endpoint (internal-only HTTP surface) ---
# ADMISSION_PRIVATE_ONLY: affirmative fail-closed opt-in for the worker's limb-(a)
# startup assertion. Unset / not "true" → the worker REFUSES to serve the admission
# listener (Backend-owned). Non-secret literal (set in docker-compose.yaml).
ADMISSION_PRIVATE_ONLY=true   # non-secret — must be exactly "true" (CA-1 opt-in); admissionConfig.ts fails closed otherwise
ADMISSION_PORT=8081           # non-secret — INTERNAL expose: port (admissionConfig default 8081); NEVER host-published (fence-admission-private-bind)
ADMISSION_HOST=0.0.0.0        # non-secret — in-container bind host; 0.0.0.0 REQUIRED for sibling Docker-network reach (CAVEAT-2). NOT the exposure control (expose:-only + no Domain is).
WORKER_ADMISSION_SHARED_SECRET=   # secret (production_only) — C6-2; SAME value as api/ web-app tier (root .env.example); Coolify project-scoped shared var; 256-bit; constant-time compare, fail-closed on absent/mismatch. NOT service_role — RT-26 unchanged.

# --- Notification routing ---
DISCORD_WEBHOOK_URL=       # secret (production_only) — Coolify->Discord incumbent
