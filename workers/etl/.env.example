# workers/etl/.env.example — pfin_back_etl container surface.
#
# Per-surface secret confinement (Phase 5 Step 8; Sec joint-review surface).
# Supersedes the prior sample.env (reconciled into this .env.example convention;
# .gitignore tracks `*.env.example` via the `!.env.example` negation).
#
# Anchors (verified verbatim 2026-06-28):
#   - ARCH §5 → pfin_back_etl container env-var scope: "Postgres conn-string
#     (service_role tier; consumed only via TenantBoundConnection class);
#     PLAID_CLIENT_ID / PLAID_SECRET; FMP_API_KEY (BLS framed "free/open" in ARCH §5)."
#   - ADR-011 Lock 13 mod #3 — TenantBoundConnection: ALL pfin DB access binds
#     users_id at construction; raw psycopg connections are a fence-tbc violation.
#   - ADR-002 §6.0 — secrets discipline (Coolify-injected in production).
#   - workers/etl/src/pfin_back_etl/utils.py load_env_variables() — the names
#     the running code actually consumes (env_prefix "PFIN_" for DB params).
#
# Secret-store assignment: ALL values below are PRODUCTION-ONLY (Coolify-injected
# on cax21). See secrets-manifest.yml. Any CI/test analogue MUST take a distinct
# name (e.g. *_SANDBOX) and live ONLY in the manifest's ci_only set.
#
# REPRESENTATION NOTE (flagged for Sec joint-review): ARCH §5 phrases the DB
# secret as a single "Postgres conn-string". The incumbent code consumes DISCRETE
# PFIN_DB_* params (utils.py). This file mirrors the running code (discrete) to
# avoid breaking production; the discrete-vs-conn-string shape is a representation
# difference, not a scope difference.
#
# TBC NOTE (reworded per Sec joint-review 2026-06-28): the service_role-tier DB
# connection MUST be consumed via TenantBoundConnection per Lock 13 mod #3 — this
# is FORWARD DISCIPLINE, not current state. The TBC class is NOT yet implemented
# in workers/etl/src/ (incumbent uses SQLAlchemy create_engine, core.py); TBC +
# its fence coverage land at Wave 6. See workers/CLAUDE.md ("ETL CI coverage is a
# tracked follow-up, not yet wired").

# Supabase Postgres connection (service_role tier). MUST be consumed via
# TenantBoundConnection per Lock 13 mod #3 (forward discipline — TBC class not yet
# implemented in workers/etl/src/; incumbent uses SQLAlchemy create_engine; TBC +
# fence coverage land Wave 6).
PFIN_DB_USER=<example::postgres.your_project_ref>
PFIN_DB_HOST=<example::db.your_project.supabase.co>
PFIN_DB_PORT=<example::5432>
PFIN_DB_NAME=<example::postgres>
PFIN_DB_PASSWORD=<supabase-db-password>

# FMP (Financial Modeling Prep) — security-price reference-data ingestion.
# Required by code (utils.py raises if absent).
FMP_API_KEY=<financial-modeling-prep-api-key>

# BLS (Bureau of Labor Statistics) — CPI-U reference-data ingestion.
# DISCREPANCY (flagged for Sec/ARCH, NOT silently reconciled): ARCH §5 frames BLS
# as "free/open" (no key), but the incumbent code
# (utils.py) REQUIRES BLS_API_KEY (raises ValueError if absent). The BLS public
# API accepts an optional registration key that raises rate limits. Retained
# here to match the running production reality; flagged so ARCH §5 and the code
# requirement can be reconciled deliberately.
BLS_API_KEY=<bureau-of-labor-statistics-api-key>
BLS_SERIES_ID=CUUR0000SA0

# Plaid credentials — scheduled-poll worker (ARCH §5 lists Plaid creds on this
# container). NOT yet consumed by the incumbent ETL code; they ACTIVATE with the
# Wave 6 Plaid scheduled-poll worker (Backend). Listed here per ARCH §5 so the
# container's secret contract is complete; sandbox tier in V1.0 per workers/CLAUDE.md.
PLAID_CLIENT_ID=<plaid-client-id>
PLAID_SECRET=<plaid-secret>
