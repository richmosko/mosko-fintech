-- =====================================================================
-- RLS battery — shared assertion verbs (helper-placement Option C via \ir)
-- =====================================================================
-- NOT a standalone pgTAP test — has no plan()/finish(). It is `\ir`-included
-- at the top of each battery test file (inside that test's begin…rollback txn),
-- so the verbs are (re)created transactionally per test and rolled back with it.
-- This keeps a single DRY verb source (Option C) without depending on cross-file
-- pgTAP state persistence or a specific seed-load mechanism.
--
-- Excluded from the test run by its NON-TEST EXTENSION (`.psql`, not `.sql`/`.pg`):
-- `supabase test db` (directory-mode, no args) mounts the whole `supabase/tests`
-- tree and `pg_prove -r` recurses, but only `*.sql`/`*.pg` are collected as tests,
-- so this planless verbs file is mounted (so `\ir` resolves) but never run.
-- Root-caused on PR #106 first run (DevOps 2026-06-25): explicit-files mode binds
-- each file alone with no parent dir, breaking `\ir`; directory-mode + the `.psql`
-- extension is the fix and keeps the per-test `\ir` model unchanged.
-- DevOps job has a fail-closed guard: any `.sql`/`.pg` under `_fixtures/` errors.
--
-- Contract (firmed per team-lead relay 2026-06-25):
--   RLS predicate convention: users_id = auth.uid()  (post 001_pfin_foundation)
--   tenant context: role=authenticated + request.jwt.claims.sub
-- =====================================================================

create schema if not exists _rls;

-- fixed synthetic tenant identities (deterministic, diffable)
create or replace function _rls.tenant_a() returns uuid
  language sql immutable as $$ select '00000000-0000-0000-0000-00000000000a'::uuid $$;
create or replace function _rls.tenant_b() returns uuid
  language sql immutable as $$ select '00000000-0000-0000-0000-00000000000b'::uuid $$;

-- set the active tenant RLS context for subsequent statements (within the txn)
create or replace function _rls.set_tenant(p_tenant uuid) returns void
  language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_tenant::text, 'role', 'authenticated')::text,
    true
  );
end;
$$;

-- count rows of p_table with users_id=p_owner that p_intruder can see (the probe)
create or replace function _rls._visible_owner_rows(
  p_table regclass, p_owner uuid, p_intruder uuid
) returns bigint
  language plpgsql as $$
declare n bigint;
begin
  perform _rls.set_tenant(p_intruder);
  execute format('select count(*) from %s where users_id = $1', p_table)
    into n using p_owner;
  perform set_config('role', 'postgres', true);  -- restore for the next assertion
  return n;
end;
$$;

-- VERB: intruder must see ZERO of owner's rows (cross-tenant read fails closed)
create or replace function _rls.expect_cross_tenant_read_empty(
  p_table regclass, p_owner uuid, p_intruder uuid
) returns text
  language sql as $$
  select is(
    _rls._visible_owner_rows(p_table, p_owner, p_intruder),
    0::bigint,
    format('cross-tenant read fails closed: intruder sees 0 owner rows in %s', p_table)
  );
$$;

-- VERB: owner must see exactly N of its own rows (guards over-restrictive policy)
create or replace function _rls.expect_owner_can_read(
  p_table regclass, p_owner uuid, p_expected bigint
) returns text
  language sql as $$
  select is(
    _rls._visible_owner_rows(p_table, p_owner, p_owner),
    p_expected,
    format('owner reads exactly %s own rows in %s (not over-restrictive)', p_expected, p_table)
  );
$$;

-- VERB: intruder write into owner-owned space must fail closed (RLS WITH CHECK)
-- p_insert_sql targets p_table with the OWNER's users_id; must raise under intruder.
create or replace function _rls.expect_cross_tenant_write_blocked(
  p_intruder uuid, p_insert_sql text, p_desc text default null
) returns text
  language plpgsql as $$
begin
  perform _rls.set_tenant(p_intruder);
  return throws_ok(
    p_insert_sql,
    '42501',  -- insufficient_privilege / RLS violation
    null,
    coalesce(p_desc, 'cross-tenant write fails closed (RLS WITH CHECK rejects intruder)')
  );
end;
$$;

-- =====================================================================
-- AAL / STEP-UP extensions (SELF-291 / Auth-3b; migration 025 aal2 backstop).
--   Additive to the two-tenant harness — same \ir-per-test transactional model.
--   Lets a battery set an authenticated context WITH an explicit `aal` JWT claim
--   (the 025 backstop keys off auth.jwt()->>'aal'), a service_role context (no aal —
--   the MB-1 guard keys off current_user='authenticated', so service_role is
--   deliberately ungated), a third fixed tenant (the missing-user_settings-row /
--   lazy-provision case), and a generic "count visible rows under (tenant, aal)"
--   probe. Reusable by any future step-up battery — SELF-289 passkey rides the
--   identical clause with zero change. No existing verb is altered.
-- =====================================================================

-- third fixed synthetic tenant (for the missing-user_settings-row / lazy-provision case)
create or replace function _rls.tenant_c() returns uuid
  language sql immutable as $$ select '00000000-0000-0000-0000-00000000000c'::uuid $$;

-- set an authenticated RLS context WITH an explicit aal claim (read as auth.jwt()->>'aal').
-- Mirrors _rls.set_tenant but adds the 'aal' claim the 025 backstop conditions on.
create or replace function _rls.set_tenant_aal(p_tenant uuid, p_aal text) returns void
  language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_tenant::text, 'role', 'authenticated', 'aal', p_aal)::text,
    true
  );
end;
$$;

-- set a service_role RLS context (bypasses RLS; carries NO sub and NO aal claim).
-- Used to prove the MB-1 guard (current_user='authenticated') does NOT gate the
-- server-side recovery channel.
create or replace function _rls.set_service_role() returns void
  language plpgsql as $$
begin
  perform set_config('role', 'service_role', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object('role', 'service_role')::text,
    true
  );
end;
$$;

-- PROBE: number of rows p_count_sql returns under (p_tenant, p_aal). p_aal NULL =>
-- an aal-LESS authenticated session (auth.jwt()->>'aal' is NULL → the backstop's
-- coalesce(...,'none') path). Restores role=postgres before returning (PR #121
-- role discipline — no _rls.* runs left under authenticated).
create or replace function _rls.count_as(p_tenant uuid, p_aal text, p_count_sql text)
  returns bigint
  language plpgsql as $$
declare n bigint;
begin
  if p_aal is null then
    perform _rls.set_tenant(p_tenant);
  else
    perform _rls.set_tenant_aal(p_tenant, p_aal);
  end if;
  execute p_count_sql into n;
  perform set_config('role', 'postgres', true);
  return n;
end;
$$;
