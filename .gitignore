# Secrets — never commit
.env
.env.*
!.env.example
# scripts/ci/fence-push-secrets-strikes.sh's own fixtures -- push-production-
# secrets.sh reads "$REPO_ROOT/.env" by exact filename, so its offline test
# fixtures must be named exactly `.env` too. Fixture strings only (see
# their own header comments), never a real credential.
!tests/fixtures/ci/push-secrets/repo-root/.env
!tests/fixtures/ci/push-secrets/repo-root-unmapped/.env

# Local working files (planning drafts, scratch)
temp/

# Personal financial taxonomy seed (SELF-231) — F/CTO's own Cat×Sub-Cat + tax
# attributes + local-dev user UUID; local-only, auto-loaded at `supabase db reset`.
supabase/seed.sql

# Doc review sidecars (per-section comments; resolution is the doc change via PR)
# Per ADR-010 — comments-sidecar feature port from project_template
docs/*/comments.md

# Local isolation tests (Mermaid render tests, etc. — diagnostic harnesses not for PR)
docs/test.html
docs/test-*.html

# Claude Code: worktrees are pointers, not artifacts; personal settings overrides
.claude/worktrees/
.claude/settings.local.json

# Node — root package.json is the Husky hook host (Phase 5 Step 8); the lockfile
# is committed (npm-audit needs it) but installed deps are not.
node_modules/

# Python bytecode caches (workers/etl/ + any Python)
__pycache__/
*.py[cod]
.pytest_cache/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
.vscode/
.idea/

# Python editable-install artifacts
*.egg-info/

# Sec flag 2026-08-12 (SELF-217 review): run logs concentrate real financial figures
*.log
