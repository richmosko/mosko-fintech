# Secrets — never commit
.env
.env.*
!.env.example

# Local working files (planning drafts, scratch)
temp/

# Doc review sidecars (per-section comments; resolution is the doc change via PR)
# Per ADR-010 — comments-sidecar feature port from project_template
docs/*/comments.md

# Local isolation tests (Mermaid render tests, etc. — diagnostic harnesses not for PR)
docs/test.html
docs/test-*.html

# Claude Code: worktrees are pointers, not artifacts; personal settings overrides
.claude/worktrees/
.claude/settings.local.json

# Node — root package.json is the Husky hook host (Phase 5 Step 8); the lockfile
# is committed (npm-audit needs it) but installed deps are not.
node_modules/

# Python bytecode caches (workers/etl/ + any Python)
__pycache__/
*.py[cod]
.pytest_cache/

# OS noise
.DS_Store
Thumbs.db

# Editor noise
*.swp
*.swo
.vscode/
.idea/
