#!/usr/bin/env bash
#
# fake-curl -- offline stand-in for curl, used by
# scripts/ci/fence-provision-worker-strikes.sh to drive
# scripts/provision-worker.sh's remote python driver against CANNED Coolify
# API responses instead of a live box. Generalised sibling of
# tests/fixtures/ci/provision-app/fake-curl -- same shape, parametrised by
# $FAKE_RESOURCE_NAME (the fence sets it per scenario/resource under test)
# instead of a single hardcoded "pfin-app". Selected by PATH precedence
# inside the fence's fake `ssh` wrapper -- provision-worker.sh itself is
# never modified or made aware this exists.
#
# Every response is followed by a bare status-code line with NO leading
# newline stripped -- mirrors provision-worker.sh's own api() helper
# (`curl -sS ... -w '\n%{http_code}'`, rpartition()d before json.loads()).
# `respond()` below reproduces that exact shape; every branch must go
# through it.
#
# Endpoints covered ($FAKE_CURL_MODE selects which fixture shape):
#   GET /applications      -- "clean"/"env-nonzero" (delete-guard
#                              scenarios): TWO applications, the Supabase
#                              stack (nested environment.uuid, path (a)
#                              fires) and a STALE $FAKE_RESOURCE_NAME
#                              (build_pack "dockerfile"). "absent"
#                              (create-path scenarios): stack app ONLY.
#   GET /projects, GET /projects/<uuid>/environments -- same dual-path
#                              coverage as provision-app's own fixture.
#   GET .../envs            -- for $OLD_APP_UUID: empty array, unless
#                              $FAKE_CURL_MODE is "env-nonzero" (one entry,
#                              names only). For $NEW_APP_UUID (post-create
#                              readback): one entry, keyed by whatever
#                              $FAKE_NETWORK_VAR names, value "stack-net" --
#                              matching the only value the script's own
#                              logic ever PATCHes for the resource under
#                              test.
#   GET /servers            -- one server named "localhost".
#   POST /applications/public -- validates the POSTed body against
#                              Coolify's OWN required-key set,
#                              UNCONDITIONALLY: 422 naming the first missing
#                              key, or 200 with the new application's uuid.
#   GET /applications/<uuid> -- source-commit-in-build report.
#   PATCH .../envs/bulk     -- validates the PATCHed body has a non-empty
#                              `data` array of `{key, value}` objects -- 200
#                              empty body on success, else 400 with
#                              Coolify's own measured error text for a
#                              body-less/malformed PATCH.
#   PATCH /applications/<uuid> (bare, not .../envs/*) -- CA-1 domain-clear:
#                              200 always; writes $FAKE_CLEAR_MARKER unless
#                              $FAKE_CLEAR_BROKEN=1 (simulates a wrong
#                              field-name guess Coolify 200s but ignores).
#                              The following GET .../applications/<uuid>
#                              reports fqdn/ports_exposes empty only once
#                              that marker exists -- see
#                              $FAKE_DEFAULT_FQDN/$FAKE_DEFAULT_PORTS_EXPOSES
#                              above the GET branch itself.
#
# Logs its OWN ARGV (never the -K config FILE's contents, never a
# --data-binary body FILE's contents) to $FAKE_CURL_LOG, so the fence can
# assert the fake token never appears there.

set -euo pipefail

LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$*" >> "$LOG"

respond() {
  local body="$1" code="${2:-200}"
  printf '%s\n%s' "$body" "$code"
  exit 0
}

METHOD="GET"
prev=""
BODY_FILE=""
for a in "$@"; do
  if [[ "$prev" == "-X" ]]; then METHOD="$a"; fi
  if [[ "$prev" == "--data-binary" && "$a" == @* ]]; then BODY_FILE="${a#@}"; fi
  prev="$a"
done
URL="${*: -1}"

# --state provably-read-only proof (Sec run-11-stop requirement 3):
# when this is set, ANY non-GET call fails closed -- a --state
# scenario that still exits 0 against this fake proves the code path
# makes zero POST/PATCH/DELETE calls, not merely that this fixture
# happens not to model one.
if [[ -n "${FAKE_FAIL_ON_WRITE:-}" && "$METHOD" != "GET" ]]; then
  respond '{"message":"fake-curl: write call attempted under FAKE_FAIL_ON_WRITE -- --state must be provably read-only"}' 500
fi

RESOURCE_NAME="${FAKE_RESOURCE_NAME:-pfin-back-etl}"
NETWORK_VAR="${FAKE_NETWORK_VAR:-ETL_STACK_NETWORK_NAME}"

STACK_UUID="aaaa1111bbbb2222cccc3333"
ENV_UUID="eeee7777ffff8888aaaa9999"
PROJECT_UUID="ffff0000aaaa1111bbbb2222"
OLD_APP_UUID="dddd4444eeee5555ffff6666"
NEW_APP_UUID="9999cccc8888dddd7777eeee"
SERVER_UUID="1111aaaa2222bbbb3333cccc"

if [[ "$METHOD" == "GET" && "$URL" == *"/applications" ]]; then
  if [[ "${FAKE_CURL_MODE:-clean}" == "absent" ]]; then
    respond "$(printf '[{"uuid":"%s","name":"pfin-supabase-stack","build_pack":"dockercompose","environment":{"uuid":"%s"}}]' "$STACK_UUID" "$ENV_UUID")"
  fi
  respond "$(printf '[{"uuid":"%s","name":"pfin-supabase-stack","build_pack":"dockercompose","environment":{"uuid":"%s"}},{"uuid":"%s","name":"%s","build_pack":"dockerfile"}]' \
    "$STACK_UUID" "$ENV_UUID" "$OLD_APP_UUID" "$RESOURCE_NAME")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/projects/$PROJECT_UUID/environments" ]]; then
  respond "$(printf '[{"uuid":"%s","name":"production"}]' "$ENV_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/projects" ]]; then
  respond "$(printf '[{"uuid":"%s","name":"pfin-supabase"}]' "$PROJECT_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/servers" ]]; then
  respond "$(printf '[{"uuid":"%s","name":"localhost"}]' "$SERVER_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"$NEW_APP_UUID/envs" ]]; then
  respond "$(printf '[{"key":"%s","value":"stack-net","is_preview":false}]' "$NETWORK_VAR")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/envs" ]]; then
  if [[ "${FAKE_CURL_MODE:-clean}" == "env-nonzero" ]]; then
    respond '[{"key":"SOME_NAME","value":"x","is_preview":false}]'
  fi
  respond '[]'
fi

if [[ "$METHOD" == "POST" && "$URL" == *"/applications/public" ]]; then
  if [[ -z "$BODY_FILE" || ! -f "$BODY_FILE" ]]; then
    respond '{"message":"fake-curl: no --data-binary @file found in argv"}' 500
  fi
  MISSING=""
  for key in project_uuid environment_uuid server_uuid git_repository git_branch build_pack name base_directory docker_compose_location; do
    if ! grep -q "\"$key\":" "$BODY_FILE"; then
      MISSING="$key"
      break
    fi
  done
  if [[ -n "$MISSING" ]]; then
    respond "$(printf '{"message":"Validation failed.","errors":{"%s":["This field is required."]}}' "$MISSING")" 422
  fi
  respond "$(printf '{"uuid":"%s"}' "$NEW_APP_UUID")"
fi

if [[ "$METHOD" == "GET" && ( "$URL" == *"/applications/$NEW_APP_UUID" || "$URL" == *"/applications/$OLD_APP_UUID" ) ]]; then
  # --state (run-11 stop fix) reads an EXISTING resource, resolved to
  # $OLD_APP_UUID under "clean" mode -- same response shape as the
  # post-create readback below (parameterized on which uuid actually
  # matched), so a --state scenario can drive FAKE_DEFAULT_FQDN/
  # FAKE_DEFAULT_PORTS_EXPOSES exactly like every other CA-1 scenario
  # here, without a second near-duplicate branch.
  REPORT_UUID="$NEW_APP_UUID"
  [[ "$URL" == *"/applications/$OLD_APP_UUID" ]] && REPORT_UUID="$OLD_APP_UUID"
  # CA-1 (run-8 stop, 2026-09-21; mechanism split confirmed by team-lead's
  # live measurement): $FAKE_DEFAULT_FQDN/$FAKE_DEFAULT_PORTS_EXPOSES
  # simulate Coolify's own default-assigned domain/port on a fresh
  # application. `fqdn` is NEVER PATCHed by the real script any more (no
  # public-API clear path exists for it on a dockercompose app -- MEASURED,
  # see provision-worker.sh's own header) -- FQDN_VAL is therefore always
  # just the default, unaffected by any marker. `ports_exposes` DOES have
  # a working PATCH mechanism, so PORTS_VAL reacts to $FAKE_CLEAR_MARKER
  # (written by the bare PATCH /applications/<uuid> branch below, UNLESS
  # $FAKE_CLEAR_BROKEN=1 simulates that PATCH not taking) -- reproducing
  # "the clear actually took, verified by a fresh read."
  FQDN_VAL="${FAKE_DEFAULT_FQDN:-}"
  PORTS_VAL="${FAKE_DEFAULT_PORTS_EXPOSES:-}"
  if [[ -n "${FAKE_CLEAR_MARKER:-}" && -f "$FAKE_CLEAR_MARKER" ]]; then
    PORTS_VAL=""
  fi
  # CA-1 fqdn tinker write (Sec-ruled mechanism, PR #862 review) -- a
  # SEPARATE marker from ports_exposes's own $FAKE_CLEAR_MARKER, since
  # these are two independent clear mechanisms (API PATCH vs box-side
  # tinker write) that must not be conflated.
  if [[ -n "${FAKE_FQDN_CLEAR_MARKER:-}" && -f "$FAKE_FQDN_CLEAR_MARKER" ]]; then
    FQDN_VAL=""
  fi
  # Built into a variable FIRST, never an inline $(...) as a direct
  # function argument -- the SAME bash-3.2 argument-position defect
  # provision-app.sh's/provision-worker.sh's own headers document in
  # full: an inline `respond "$(python3 -c "...")"` mis-parses under
  # bash 3.2, splitting the dict literal's braces at the comma into
  # multiple SyntaxErrors and silently sending an empty response body
  # (measured while golden-testing this exact fixture edit -- caught it
  # myself before it shipped).
  RESPONSE_BODY="$(python3 -c "
import json
fqdn = '$FQDN_VAL' or None
ports = '$PORTS_VAL' or None
print(json.dumps({'uuid': '$REPORT_UUID', 'settings': {'include_source_commit_in_build': False}, 'fqdn': fqdn, 'ports_exposes': ports}))
")"
  respond "$RESPONSE_BODY"
fi

if [[ "$METHOD" == "PATCH" && "$URL" == *"/applications/$NEW_APP_UUID" && "$URL" != *"/envs"* ]]; then
  # The bare application-resource PATCH -- ports_exposes clear ONLY now
  # (the real script never PATCHes fqdn here any more; see this file's
  # own GET branch comment). Distinct endpoint shape from the
  # /envs/bulk PATCH below. Writes the marker file UNLESS
  # $FAKE_CLEAR_BROKEN=1 (models a PATCH that 200s but the value never
  # actually changes -- a defensive scenario for "this resource behaves
  # differently than the measured-working case," not a live-observed
  # Coolify behavior).
  if [[ "${FAKE_CLEAR_BROKEN:-0}" != "1" && -n "${FAKE_CLEAR_MARKER:-}" ]]; then
    touch "$FAKE_CLEAR_MARKER" 2>/dev/null || true
  fi
  respond '{}'
fi

if [[ "$METHOD" == "PATCH" && "$URL" == *"/envs/bulk" ]]; then
  if [[ -z "$BODY_FILE" || ! -f "$BODY_FILE" ]]; then
    respond '{"message":"Content-Type must be application/json"}' 400
  fi
  if ! python3 -c "
import json, sys
d = json.load(open('$BODY_FILE'))
rows = d.get('data')
if not isinstance(rows, list) or not rows:
    sys.exit(1)
for r in rows:
    if not isinstance(r, dict) or 'key' not in r or 'value' not in r:
        sys.exit(1)
" >/dev/null 2>&1; then
    respond '{"message":"Content-Type must be application/json"}' 400
  fi
  respond '{}'
fi

if [[ "$METHOD" == "DELETE" ]]; then
  respond '{}'
fi

respond '{}'
