#!/usr/bin/env bash
#
# fake-curl -- offline stand-in for curl, used by
# scripts/ci/fence-db-bootstrap-strikes.sh to drive
# scripts/db-bootstrap.sh's remote python driver (PY_API_HELPER's api())
# against a canned Coolify API response instead of a live box.
#
# Sec VETO-1 r2 (PR #849 review, PATH A): db-bootstrap.sh's own leg D
# (mint + PATCH /applications/{uuid}/envs/bulk) was REMOVED entirely --
# legs A and E now read MIGRATOR_DB_PASSWORD via `docker exec coolify php
# artisan tinker` directly (handled by the fake docker in
# fence-db-bootstrap-strikes.sh, never curl). The ONLY curl call this
# script's own python driver still makes is the top-of-script GET
# /applications UUID resolution (stack app + migrator app, one call).
# This fixture therefore only implements that one shape -- a prior round
# implemented a second, PATCH-based shape for leg D's own push; that leg
# no longer exists in the real script, so that branch was removed here
# rather than left as dead, never-exercised code (same standard applied
# throughout this repo's fixtures: no untested branch left behind).
#
# GET /applications resolves BOTH the stack app (pfin-supabase-stack) and
# the migrator app (pfin-migrator) in one call. $FAKE_CURL_MODE selects
# which (if either) is omitted:
#   clean            -- both present
#   stack-absent     -- migrator present, stack omitted
#   migrator-absent  -- stack present, migrator omitted

set -euo pipefail

LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$*" >> "$LOG"

METHOD="GET"
prev=""
for a in "$@"; do
  if [[ "$prev" == "-X" ]]; then METHOD="$a"; fi
  prev="$a"
done
URL="${*: -1}"

STACK_UUID="aaaa1111bbbb2222cccc3333"
MIGRATOR_UUID="dddd4444eeee5555ffff6666"

if [[ "$METHOD" == "GET" && "$URL" == *"/applications" ]]; then
  STACK_ROW=""
  MIGRATOR_ROW=""
  MODE="${FAKE_CURL_MODE:-clean}"
  [[ "$MODE" != "stack-absent" ]] && STACK_ROW="$(printf '{"uuid":"%s","name":"pfin-supabase-stack"}' "$STACK_UUID")"
  [[ "$MODE" != "migrator-absent" ]] && MIGRATOR_ROW="$(printf '{"uuid":"%s","name":"pfin-migrator"}' "$MIGRATOR_UUID")"
  ROWS=()
  [[ -n "$STACK_ROW" ]] && ROWS+=("$STACK_ROW")
  [[ -n "$MIGRATOR_ROW" ]] && ROWS+=("$MIGRATOR_ROW")
  IFS=,
  printf '[%s]' "${ROWS[*]}"
  exit 0
fi

printf '{}'
exit 0
