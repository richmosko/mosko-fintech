#!/usr/bin/env bash
#
# fake-curl -- offline stand-in for curl, used by
# scripts/ci/fence-smoke-remaining-checks-strikes.sh. Distinguishes FOUR
# call shapes by URL substring, matching the four places
# scripts/smoke-remaining-checks.sh invokes curl (three top-level, one
# inside a remote python subprocess call):
#   1. Coolify API (localhost:8000/api/v1/...) -- canned application list
#      naming the stack + sibling apps and their fqdn per FAKE_STACK_FQDN
#      / FAKE_SIBLING_FQDN.
#   2. GET .../login -- prints $FAKE_LOGIN_STATUS (the %{http_code} shape
#      the real -w '%{http_code}' -o /dev/null invocation produces).
#   3. POST .../signup -- prints $FAKE_SIGNUP_STATUS, same shape.
#   4. Anything else -- unrecognised, fails loudly (never silently "000"
#      -- a silent default would mask a real call-shape drift).

set -euo pipefail

ARGS="$*"
LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$ARGS" >> "$LOG"

if [[ "$ARGS" == *"localhost:8000/api/v1"* ]]; then
  cat <<JSON
[
  {"uuid": "stackuuid000000000001", "name": "${FAKE_STACK_NAME:-pfin-supabase-stack}", "fqdn": "${FAKE_STACK_FQDN:-}"},
  {"uuid": "siblinguuid000000001", "name": "${FAKE_SIBLING_NAME:-pfin-app}", "fqdn": "${FAKE_SIBLING_FQDN:-}"}
]
JSON
  exit 0
fi

if [[ "$ARGS" == *"/login"* ]]; then
  CODE="${FAKE_LOGIN_STATUS:-200}"
  if [[ "$CODE" == "EMPTY" ]]; then
    exit 7
  fi
  printf '%s' "$CODE"
  exit 0
fi

if [[ "$ARGS" == *"/signup"* ]]; then
  CODE="${FAKE_SIGNUP_STATUS:-400}"
  if [[ "$CODE" == "EMPTY" ]]; then
    exit 7
  fi
  printf '%s' "$CODE"
  exit 0
fi

echo "FAKE CURL: unrecognised invocation: $ARGS" >&2
exit 1
