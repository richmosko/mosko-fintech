#!/usr/bin/env bash
#
# fake-curl -- offline stand-in for curl, used by
# scripts/ci/fence-deploy-app-strikes.sh to drive scripts/deploy-app.sh's
# remote python driver against CANNED Coolify API responses instead of a
# live box. Selected by PATH precedence inside the fence's fake `ssh`
# wrapper -- deploy-app.sh itself is never modified to know this exists.
#
# Logs its OWN ARGV (never the -K config FILE's contents -- same
# distinction scripts/ci/fence-coolify-env-strikes.sh's own fake-curl
# draws) to $FAKE_CURL_LOG, so the fence can assert both (a) the fake
# token string never appears there, and (b) in MISMATCH mode, that
# /deploy is never even called -- the identity guard must fire BEFORE any
# deploy attempt, not merely report the mismatch after the fact.
#
# Behaviour selected by $FAKE_CURL_MODE:
#   match       -- GET /applications returns one app with base_directory
#                  "/api" (matches the strike's --expect-base-directory),
#                  GET .../envs returns all three names the require-env
#                  strike checks for, deploy succeeds, deployment status
#                  "finished".
#   mismatch    -- GET /applications returns base_directory "/wrong" --
#                  deploy-app.sh's identity guard must die() before any
#                  /deploy call is ever made.
#   missing-env -- base_directory matches ("/api"), but GET .../envs
#                  omits one required name -- deploy-app.sh's
#                  required-env-names guard must die() before any
#                  /deploy call is ever made.
#   network-match     -- a second app ("pfin-stack") shares environment_id
#                         and both carry connect_to_docker_network=true --
#                         --require-network-with must pass.
#   network-diff-env  -- the two apps have DIFFERENT environment_id --
#                         --require-network-with must refuse.
#   network-off       -- same environment_id, but the OTHER app carries
#                         connect_to_docker_network=false --
#                         --require-network-with must refuse.

set -euo pipefail

LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$*" >> "$LOG"

METHOD="GET"
prev=""
for a in "$@"; do
  if [[ "$prev" == "-X" ]]; then METHOD="$a"; fi
  prev="$a"
done
URL="${*: -1}"

BASE_DIR="/api"
[[ "${FAKE_CURL_MODE:-match}" == "mismatch" ]] && BASE_DIR="/wrong"

# Network-guard fields for the two applications -- defaults describe the
# happy path (network-match); the other two modes flip exactly one field.
APP_ENV_ID=5
STACK_ENV_ID=5
APP_NET=true
STACK_NET=true
case "${FAKE_CURL_MODE:-match}" in
  network-diff-env) STACK_ENV_ID=6 ;;
  network-off)      STACK_NET=false ;;
esac

if [[ "$METHOD" == "GET" && "$URL" == *"/applications" ]]; then
  printf '[{"uuid":"abc123def456ghi789jk01","name":"pfin-app","base_directory":"%s","fqdn":"http://test.example.sslip.io"},{"uuid":"stack000000000000000001","name":"pfin-stack","base_directory":"/infra/supabase"}]' "$BASE_DIR"
  exit 0
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/applications/abc123def456ghi789jk01" ]]; then
  printf '{"uuid":"abc123def456ghi789jk01","environment_id":%s,"settings":{"connect_to_docker_network":%s}}' "$APP_ENV_ID" "$APP_NET"
  exit 0
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/applications/stack000000000000000001" ]]; then
  printf '{"uuid":"stack000000000000000001","environment_id":%s,"settings":{"connect_to_docker_network":%s}}' "$STACK_ENV_ID" "$STACK_NET"
  exit 0
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/envs" ]]; then
  if [[ "${FAKE_CURL_MODE:-match}" == "missing-env" ]]; then
    # Omits SUPABASE_SERVICE_ROLE_KEY -- the strike checks all three are
    # required and this one is deliberately absent.
    echo '[{"key":"PUBLIC_SUPABASE_URL","value":"http://api-gw:8000","is_preview":false},{"key":"PUBLIC_SUPABASE_ANON_KEY","value":"x","is_preview":false}]'
  else
    echo '[{"key":"PUBLIC_SUPABASE_URL","value":"http://api-gw:8000","is_preview":false},{"key":"PUBLIC_SUPABASE_ANON_KEY","value":"x","is_preview":false},{"key":"SUPABASE_SERVICE_ROLE_KEY","value":"y","is_preview":false}]'
  fi
  exit 0
fi

if [[ "$METHOD" == "POST" && "$URL" == *"/deploy?uuid="* ]]; then
  echo '{"deployments":[{"deployment_uuid":"dep-1"}]}'
  exit 0
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/deployments/dep-1" ]]; then
  echo '{"status":"finished","logs":"[]"}'
  exit 0
fi

echo '{}'
exit 0
