#!/usr/bin/env bash
#
# fake-curl -- offline stand-in for curl, used by
# scripts/ci/fence-smoke-admission-endpoint-strikes.sh. Distinguishes
# THREE call shapes by URL/context:
#   1. Coolify API (localhost:8000/api/v1/...) -- canned application list.
#   2. N1 (operator-machine direct probe, :8081, FAKE_SSH_CONTEXT unset)
#      -- responds per $FAKE_N1_CODE.
#   3. N2 (box-host probe via the fake ssh wrapper, :8081,
#      FAKE_SSH_CONTEXT=1) -- responds per $FAKE_N2_CODE.

set -euo pipefail

ARGS="$*"
LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$ARGS" >> "$LOG"

if [[ "$ARGS" == *"localhost:8000/api/v1"* ]]; then
  cat <<JSON
[
  {"uuid": "psuuid00000000000001", "name": "${FAKE_PS_NAME:-pfin-provider-sync}", "fqdn": "${FAKE_FQDN:-}"},
  {"uuid": "siblinguuid000000001", "name": "${FAKE_SIBLING_NAME:-pfin-app}", "fqdn": ""}
]
JSON
  exit 0
fi

if [[ "$ARGS" == *":8081"* ]]; then
  if [[ "${FAKE_SSH_CONTEXT:-0}" == "1" ]]; then
    printf '%s' "${FAKE_N2_CODE:-000}"
  else
    printf '%s' "${FAKE_N1_CODE:-000}"
  fi
  exit 0
fi

printf '000'
exit 0
