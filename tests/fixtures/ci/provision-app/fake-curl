#!/usr/bin/env bash
#
# fake-curl -- offline stand-in for curl, used by
# scripts/ci/fence-provision-app-strikes.sh to drive
# scripts/provision-app.sh's remote python driver against CANNED Coolify
# API responses instead of a live box. Selected by PATH precedence inside
# the fence's fake `ssh` wrapper -- provision-app.sh itself is never
# modified to know this exists. Same shape as
# tests/fixtures/ci/deploy-app/fake-curl.
#
# Every response is followed by a bare status-code line with NO leading
# newline stripped -- mirrors provision-app.sh's own api() helper, which
# (since the team-lead 2026-09-20 --apply 422 fix) invokes real curl as
# `curl -sS ... -w '\n%{http_code}'` and rpartition()s the trailing line
# off before json.loads(). `respond()` below reproduces that exact shape;
# every branch must go through it, never a bare `echo`/`printf` of JSON
# alone, or the real api() parser silently reads a garbage status line.
#
# Endpoints covered ($FAKE_CURL_MODE selects which fixture shape):
#   GET /applications      -- "clean"/"env-nonzero" (delete-guard
#                              scenarios): TWO applications, the Supabase
#                              stack (nested environment.uuid, so path
#                              (a) fires) and a STALE pfin-app
#                              (build_pack "dockerfile"). "absent"
#                              (create-path scenarios): stack app ONLY --
#                              no pfin-app entry, matching the REAL live
#                              state after PR #836's own delete leg
#                              succeeded and the create leg 422'd.
#   GET /projects, GET /projects/<uuid>/environments -- path (a) now
#                              ALSO resolves project_uuid by name (Sec/
#                              team-lead 2026-09-20 fix) even when the
#                              nested environment.uuid fires, so this
#                              fixture's stack app carries BOTH shapes
#                              simultaneously and this endpoint is always
#                              live, not only a path-(b) fallback.
#   GET .../envs            -- for $OLD_APP_UUID: empty array, unless
#                              $FAKE_CURL_MODE is "env-nonzero" (one
#                              entry, names only). For $NEW_APP_UUID
#                              (post-create readback): one entry,
#                              APP_STACK_NETWORK_NAME=stack-net --
#                              matching the only value the script's own
#                              logic ever PATCHes.
#   GET /servers            -- one server named "localhost".
#   POST /applications/public -- validates the POSTed body (read via the
#                              `--data-binary @<tmpfile>` argument curl
#                              actually receives, a real file on disk)
#                              against Coolify's OWN required-key set,
#                              UNCONDITIONALLY, regardless of
#                              $FAKE_CURL_MODE: 422 with Coolify's exact
#                              error shape naming the first missing key,
#                              or 200 with the new application's uuid.
#                              This is what scenario 8's strike-verify
#                              exercises: it never toggles a curl mode,
#                              it runs a MUTATED copy of
#                              provision-app.sh with project_uuid
#                              stripped from its own CREATE_BODY against
#                              this SAME unconditional check.
#   GET /applications/<uuid> -- source-commit-in-build report (settings
#                              object; provision-app.sh only reports
#                              this, never forces it -- api/Dockerfile
#                              has no SOURCE_COMMIT/GIT_SHA guard).
#   PATCH .../envs/bulk     -- validates the PATCHed body has a non-empty
#                              `data` array of `{key, value}` objects (or
#                              a `--data-binary @file` argv at all) --
#                              200 empty body on success, else 400 with
#                              Coolify's own MEASURED error text for a
#                              body-less/malformed PATCH (team-lead,
#                              2026-09-20 -- see the branch's own
#                              comment). This is scenario 7's own create-
#                              happy flow reaching this leg for real; the
#                              watcher this fixes is what a bash-3.2
#                              argument-position defect in
#                              scripts/provision-app.sh (also fixed this
#                              PR) would otherwise leave silently
#                              undetected.
#
# Logs its OWN ARGV (never the -K config FILE's contents, never a
# --data-binary body FILE's contents) to $FAKE_CURL_LOG, so the fence can
# assert the fake token never appears there.

set -euo pipefail

LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$*" >> "$LOG"

respond() {
  local body="$1" code="${2:-200}"
  printf '%s\n%s' "$body" "$code"
  exit 0
}

METHOD="GET"
prev=""
BODY_FILE=""
for a in "$@"; do
  if [[ "$prev" == "-X" ]]; then METHOD="$a"; fi
  if [[ "$prev" == "--data-binary" && "$a" == @* ]]; then BODY_FILE="${a#@}"; fi
  prev="$a"
done
URL="${*: -1}"

STACK_UUID="aaaa1111bbbb2222cccc3333"
ENV_UUID="eeee7777ffff8888aaaa9999"
PROJECT_UUID="ffff0000aaaa1111bbbb2222"
OLD_APP_UUID="dddd4444eeee5555ffff6666"
NEW_APP_UUID="9999cccc8888dddd7777eeee"
SERVER_UUID="1111aaaa2222bbbb3333cccc"

if [[ "$METHOD" == "GET" && "$URL" == *"/applications" ]]; then
  if [[ "${FAKE_CURL_MODE:-clean}" == "absent" ]]; then
    respond "$(printf '[{"uuid":"%s","name":"pfin-supabase-stack","build_pack":"dockercompose","environment":{"uuid":"%s"}}]' "$STACK_UUID" "$ENV_UUID")"
  fi
  respond "$(printf '[{"uuid":"%s","name":"pfin-supabase-stack","build_pack":"dockercompose","environment":{"uuid":"%s"}},{"uuid":"%s","name":"pfin-app","build_pack":"dockerfile"}]' \
    "$STACK_UUID" "$ENV_UUID" "$OLD_APP_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/projects/$PROJECT_UUID/environments" ]]; then
  respond "$(printf '[{"uuid":"%s","name":"production"}]' "$ENV_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/projects" ]]; then
  respond "$(printf '[{"uuid":"%s","name":"pfin-supabase"}]' "$PROJECT_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/servers" ]]; then
  respond "$(printf '[{"uuid":"%s","name":"localhost"}]' "$SERVER_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"$NEW_APP_UUID/envs" ]]; then
  respond '[{"key":"APP_STACK_NETWORK_NAME","value":"stack-net","is_preview":false}]'
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/envs" ]]; then
  if [[ "${FAKE_CURL_MODE:-clean}" == "env-nonzero" ]]; then
    respond '[{"key":"SOME_NAME","value":"x","is_preview":false}]'
  fi
  respond '[]'
fi

if [[ "$METHOD" == "POST" && "$URL" == *"/applications/public" ]]; then
  if [[ -z "$BODY_FILE" || ! -f "$BODY_FILE" ]]; then
    respond '{"message":"fake-curl: no --data-binary @file found in argv"}' 500
  fi
  MISSING=""
  for key in project_uuid environment_uuid server_uuid git_repository git_branch build_pack name base_directory docker_compose_location; do
    if ! grep -q "\"$key\":" "$BODY_FILE"; then
      MISSING="$key"
      break
    fi
  done
  if [[ -n "$MISSING" ]]; then
    respond "$(printf '{"message":"Validation failed.","errors":{"%s":["This field is required."]}}' "$MISSING")" 422
  fi
  respond "$(printf '{"uuid":"%s"}' "$NEW_APP_UUID")"
fi

if [[ "$METHOD" == "GET" && "$URL" == *"/applications/$NEW_APP_UUID" ]]; then
  respond "$(printf '{"uuid":"%s","settings":{"include_source_commit_in_build":false}}' "$NEW_APP_UUID")"
fi

if [[ "$METHOD" == "PATCH" && "$URL" == *"/envs/bulk" ]]; then
  # MEASURED (team-lead, 2026-09-20): a bash-3.2 argument-position brace-
  # expansion defect (fixed in scripts/provision-app.sh -- see that
  # script's own header) once turned this PATCH's body into an empty
  # string at the CALLER, which api()'s remote PY_API_HELPER then treats
  # as `body=None` (an empty-but-truthy-check-false argv value) --
  # `--data-binary` and the `Content-Type` header are BOTH skipped
  # entirely in that case, and Coolify 4.3.18's own real response to
  # that exact shape is `400 {"message":"Content-Type must be
  # application/json"}`, reproduced verbatim here. A missing
  # `--data-binary @file` argv (BODY_FILE empty) is that same "no body
  # sent at all" shape; a present-but-structurally-wrong body (JSON
  # without a non-empty `data` array of `{key,value}` objects) 400s the
  # same way, since Coolify would reject that shape too.
  if [[ -z "$BODY_FILE" || ! -f "$BODY_FILE" ]]; then
    respond '{"message":"Content-Type must be application/json"}' 400
  fi
  if ! python3 -c "
import json, sys
d = json.load(open('$BODY_FILE'))
rows = d.get('data')
if not isinstance(rows, list) or not rows:
    sys.exit(1)
for r in rows:
    if not isinstance(r, dict) or 'key' not in r or 'value' not in r:
        sys.exit(1)
" >/dev/null 2>&1; then
    respond '{"message":"Content-Type must be application/json"}' 400
  fi
  respond '{}'
fi

if [[ "$METHOD" == "DELETE" ]]; then
  respond '{}'
fi

respond '{}'
