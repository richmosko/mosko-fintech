#!/usr/bin/env bash
# fake-curl -- offline stand-in for curl, Coolify /applications lookup only.
set -euo pipefail
ARGS="$*"
LOG="${FAKE_CURL_LOG:-/dev/null}"
printf '%s\n' "$ARGS" >> "$LOG"
if [[ "$ARGS" == *"/applications"* ]]; then
  echo '[{"uuid": "etluuid0000000000001", "name": "pfin-back-etl"}]'
  exit 0
fi
echo '{}'
exit 0
