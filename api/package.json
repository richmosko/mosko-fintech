{
	"name": "api",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run build:report-css && vite build",
		"build:report-css": "vite build --config vite.report-css.config.mjs && rm -f src/lib/generated/report.js",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.8",
		"@types/node": "^22.0.0",
		"@types/nodemailer": "^8.0.1",
		"jsdom": "^30.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.0"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.0",
		"@supabase/supabase-js": "^2.110.0",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"jose": "^6.2.5",
		"layercake": "^10.0.3",
		"nodemailer": "^9.0.3",
		"zod": "^4.4.3"
	}
}
