# api/ — SvelteKit web-app environment (example / non-secret template)
#
# These are PUBLIC_-prefixed vars: exposed to the browser by SvelteKit via
# $env/dynamic/public (read at container runtime, not baked at build). The anon
# key is RLS-scoped and browser-safe — it is NOT a secret and is intentionally
# NOT in the secrets-manifest. In production these are injected by Coolify's
# runtime env; locally, copy this file to `.env`.
#
# The elevated service-role key is deliberately absent here. It is confined to
# the 3 RT-26 allowlist endpoints (Plaid webhook / public_token exchange / item
# remove) and is never used by the auth chokepoint. Do not add it to this file.
#
# Copy to `.env` (gitignored) and fill in for local dev.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
